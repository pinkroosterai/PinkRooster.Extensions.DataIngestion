<Project>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <AnalysisLevel>latest</AnalysisLevel>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>PinkRooster</Authors>
        <Company>PinkRooster</Company>
        <Copyright>Copyright (c) 2026 Jan Versteeg</Copyright>
    </PropertyGroup>

    <!-- One version for every project in the repository. -->
    <PropertyGroup>
        <Version>1.0.0-preview.3</Version>
    </PropertyGroup>

    <!-- Packaging & SourceLink properties -->
    <PropertyGroup>
        <PackageReleaseNotes>See https://github.com/pinkroosterai/PinkRooster.Extensions.DataIngestion/blob/main/CHANGELOG.md</PackageReleaseNotes>
        <PackageProjectUrl>https://github.com/pinkroosterai/PinkRooster.Extensions.DataIngestion</PackageProjectUrl>
        <RepositoryUrl>https://github.com/pinkroosterai/PinkRooster.Extensions.DataIngestion</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>icon.png</PackageIcon>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

</Project>
