<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>PinkRooster.Extensions.DataIngestion.CodeAnalysis</PackageId>
    <Description>Roslyn-based C# source reading and syntax-aware AST chunking for Microsoft.Extensions.DataIngestion.</Description>
    <PackageTags>rag roslyn csharp chunker syntax codeanalysis pinkrooster</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\PinkRooster.Extensions.DataIngestion.CodeAnalysis.md" Pack="true" PackagePath="/README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <ProjectReference Include="../PinkRooster.Extensions.DataIngestion.Chunkers/PinkRooster.Extensions.DataIngestion.Chunkers.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

</Project>
