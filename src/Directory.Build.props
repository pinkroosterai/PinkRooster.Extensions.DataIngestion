<Project>
  <!-- See https://aka.ms/dotnet/msbuild/customize for more details on customizing your build -->

  <!-- MSBuild stops at the nearest Directory.Build.props, so the repository-wide settings are imported explicitly. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- The shipped libraries are held to the Recommended analyzer set; tests, samples and benchmarks keep the default. -->
  <PropertyGroup>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>
</Project>
